NODE_ENV=production
PORT=8080
# Docker Compose / VPS settings. Use a long URL-safe password (letters and digits)
# because it is embedded in the internal PostgreSQL URL.
DOMAIN=bot.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgres://moneystat:change-me@localhost:5432/moneystat
DATABASE_SSL=false
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
PUBLIC_BASE_URL=https://your-service.example.com
# Comma-separated exact origins. Empty disables browser CORS.
CORS_ALLOWED_ORIGINS=https://app.example.com
PAIR_CODE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=120
BODY_LIMIT_BYTES=65536
TRUST_PROXY=false
